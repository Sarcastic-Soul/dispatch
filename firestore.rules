rules_version = '2';

// Each anonymous user gets one private desk: desks/{uid}.
// Nobody can read or write another user's desk.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /desks/{uid}/examples/{exampleId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['text', 'team', 'source', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000
        && request.resource.data.team is string
        && request.resource.data.team.size() <= 64
        && request.resource.data.source in ['seed', 'gemini-confirmed', 'staff']
        && request.resource.data.createdAt is number;
    }

    match /desks/{uid}/events/{eventId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.size() <= 20;
    }
  }
}
